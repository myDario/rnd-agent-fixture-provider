{
  "service": "rnd-agent-fixture-provider",
  "operations": [
    {
      "method": "GET",
      "path": "/health",
      "response": {
        "status": 200,
        "body": { "status": "ok" }
      }
    },
    {
      "method": "GET",
      "path": "/version",
      "response": {
        "status": 200,
        "body": { "version": "1.0.0" }
      }
    },
    {
      "method": "GET",
      "path": "/ready",
      "response": {
        "status": 200,
        "body": { "ready": true }
      }
    },
    {
      "method": "GET",
      "path": "/ping",
      "response": {
        "status": 200,
        "body": { "pong": true }
      }
    }
  ]
}
